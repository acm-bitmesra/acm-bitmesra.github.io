# ==============================================================================
# ACM BIT MESRA PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================
# In local development: copy to .env or .dev.vars
# In Cloudflare production: NEVER store secrets in git or plaintext worker vars.
# Use Cloudflare Worker Secrets:
#   npx wrangler secret put DATABASE_URL
#   npx wrangler secret put BETTER_AUTH_SECRET
#   npx wrangler secret put GOOGLE_CLIENT_ID
#   npx wrangler secret put GOOGLE_CLIENT_SECRET
#   npx wrangler secret put ADMIN_EMAIL_ALLOWLIST
# ==============================================================================

# Neon Serverless PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@ep-sample-pooler.c-7.us-east-2.aws.neon.tech/acmbitm?sslmode=require"

# Better Auth Cryptographic Session Secret (minimum 32 random characters)
BETTER_AUTH_SECRET="replace-with-a-cryptographically-secure-random-32-char-secret"

# Canonical Better Auth Public URL
BETTER_AUTH_URL="https://acmbitm.campsy.app" # Use http://localhost:3000 for local dev

# Canonical Site Public URL
PUBLIC_SITE_URL="https://acmbitm.campsy.app"

# Google OAuth 2.0 Credentials (for university Google Workspace SSO)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Administrator Email Allowlist (Comma-separated exact matching university emails for initial SUPER_ADMIN bootstrap)
ADMIN_EMAIL_ALLOWLIST="acm@bitmesra.ac.in,Btech10574.24@bitmesra.ac.in"
