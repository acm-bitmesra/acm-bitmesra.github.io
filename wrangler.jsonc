{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acm-bitmesra",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "acmbitm.campsy.app",
      "custom_domain": true
    }
  ]
}
