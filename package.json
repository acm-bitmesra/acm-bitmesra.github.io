{
  "name": "acm-bitmesra",
  "version": "1.0.0",
  "private": true,
  "description": "Official website for the ACM Student Chapter at BIT Mesra",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:prod": "node scripts/validate-production.mjs",
    "test:auth": "node --no-network-family-autoselection --dns-result-order=ipv4first scripts/test-auth-and-blog.mjs",
    "test:security": "node --no-network-family-autoselection --dns-result-order=ipv4first scripts/test-security-suite.mjs",
    "test:github": "node scripts/test-github-oauth.mjs",
    "security:scan": "node scripts/verify-no-secrets.mjs",
    "test": "bun run typecheck && bun run lint && bun run security:scan && bun run test:auth && bun run test:security && bun run test:github && bun run test:prod",
    "cf:build": "next build && opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "cf:deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && OPEN_NEXT_DEPLOY=true wrangler deploy",
    "deploy": "next build && opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && OPEN_NEXT_DEPLOY=true wrangler deploy"
  },
  "dependencies": {
    "@animateicons/react": "^0.12.0",
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.16.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7",
    "postcss": "^8.5.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^4.147.0"
  }
}
